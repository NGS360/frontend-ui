# Example environment variables for the NGS360 frontend application
# Copy this file to .env and modify the values as needed

# The API base URL is NOT configured here. The app addresses the API with
# relative URLs, because in every deployed environment nginx serves this bundle
# and proxies /api to FastAPI on the same origin. That keeps the build
# environment-neutral, so one artifact can be promoted from staging to prod
# unchanged.
#
# For local development, vite.config.js proxies the API paths to
# http://127.0.0.1:8000. Override that target to develop against a deployed
# environment instead:
# VITE_DEV_API_PROXY=https://your-deployed-environment.example.com

# Set to false to hide the AI Assistant (header button and chat panel).
# Read at build time, so changing it needs a rebuild. Unset means enabled.
VITE_AI_CHAT_ENABLED=true
